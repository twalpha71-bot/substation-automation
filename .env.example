# SAS Engineering Hub — Environment & Initial Admin Provisioning Configuration
# Copy to .env before starting the backend authentication server:

PORT=4000
NODE_ENV=production
DATABASE_URL=sqlite://./data/sas_engineering_hub.db
SESSION_COOKIE_NAME=sas_hub_session
SESSION_SECRET=REPLACE_WITH_64_BYTE_CRYPTOGRAPHIC_RANDOM_HEX_SECRET
CSRF_SECRET=REPLACE_WITH_32_BYTE_CRYPTOGRAPHIC_CSRF_SECRET

# Controlled Initial Admin Provisioning (Run once via `npm run provision-admin`):
INITIAL_ADMIN_EMAIL=admin@sas-engineering-hub.org
INITIAL_ADMIN_SETUP_TOKEN=CHANGE_ME_ONE_TIME_PROVISIONING_TOKEN
